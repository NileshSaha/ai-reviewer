# Application
NODE_ENV=development
PORT=5999

# GitHub
GITHUB_PAT=ghp_xxxxxxxxxxxxxxxxxxxx
GITHUB_USERNAME=your-github-username
POLL_INTERVAL=60

# Repositories (comma-separated, format: owner/repo)
REPOSITORIES=owner/repo-one,owner/repo-two,owner/repo-three

# AI Provider (minimax, gemini, openrouter, groq, openai)
# Primary provider to use first (fallback priority: Minimax -> Gemini -> OpenRouter -> Groq -> OpenAI)
LLM_PROVIDER=minimax

# AI API Keys (Configure primary key and optional fallbacks)
# MiniMax:
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M3
MINIMAX_API_ENDPOINT=https://api.minimax.io/v1/chat/completions

# Google Gemini:
GEMINI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_API_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions

# OpenRouter (Fallback 3):
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_API_ENDPOINT=https://openrouter.ai/api/v1/chat/completions

# Groq (Fallback 4):
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_API_ENDPOINT=https://api.groq.com/openai/v1/chat/completions

# OpenAI (Optional):
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_ENDPOINT=https://api.openai.com/v1/chat/completions

# Approval threshold (0-100)
APPROVAL_THRESHOLD=80

# Hide the score line in the review body when score is below this value (0-100)
SKIP_REVIEW_BELOW_SCORE=70

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/ai_reviewer

# Concurrency & rate limiting
CONCURRENCY_LIMIT=2
STAGGER_DELAY_SECONDS=10
COOLDOWN_MINUTES=10

