# Application
NODE_ENV=development
PORT=5999

# GitHub
GITHUB_PAT=ghp_xxxxxxxxxxxxxxxxxxxx
GITHUB_USERNAME=your-github-username
POLL_INTERVAL=60

# Repositories (comma-separated, format: owner/repo)
REPOSITORIES=owner/repo-one,owner/repo-two,owner/repo-three

# AI Provider (minimax, groq, openai)
LLM_PROVIDER=groq

# AI API Keys (set only the one you're using)
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M3
GROQ_API_KEY=
OPENAI_API_KEY=

# Approval threshold (0-100)
APPROVAL_THRESHOLD=80

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/ai_reviewer

# Concurrency & rate limiting
CONCURRENCY_LIMIT=2
STAGGER_DELAY_SECONDS=10
COOLDOWN_MINUTES=10

